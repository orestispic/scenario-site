# Public web configuration — no real credentials.
NEXT_PUBLIC_SCENARIO_API_BASE_URL=https://api.example.invalid
NEXT_PUBLIC_SCENARIO_APP_DOWNLOAD_URL=https://downloads.example.invalid/scenario
NEXT_PUBLIC_SCENARIO_AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-placeholder
SCENARIO_SESSION_COOKIE_NAME=scenario_session
# Server-only placeholders. Set real values only in the future secret manager.
SCENARIO_ENVIRONMENT=staging
API_ALLOWED_ORIGINS=https://app.example.invalid,https://scenario.example.invalid
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=replace_in_secret_manager
# Prefer the current sb_secret_ format. The legacy service_role variable remains
# supported temporarily for existing isolated environments.
SUPABASE_SECRET_KEY=never_expose_or_commit
# SUPABASE_SERVICE_ROLE_KEY=legacy_only_never_expose_or_commit
SUPABASE_JWT_AUDIENCE=authenticated
DEVICE_FINGERPRINT_PEPPER=generate_in_secret_manager
OFFLINE_GRANT_PRIVATE_JWK=generate_p256_private_jwk_in_secret_manager
OFFLINE_GRANT_PUBLIC_JWK=matching_public_jwk
OFFLINE_GRANT_KEY_ID=scenario-staging-1
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PEPPER=generate_separate_random_value_in_secret_manager
STRIPE_SECRET_KEY=sk_test_replace_in_secret_manager
STRIPE_WEBHOOK_SECRET=whsec_replace_in_secret_manager
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
ACTIVATION_KEY_PEPPER=generate_in_secret_manager
OPENAI_API_KEY=never_expose_or_commit
OPENAI_SHORT_ACTION_MODEL=configure_in_server_secret_manager
OPENAI_PDF_IMPORT_MODEL=configure_in_server_secret_manager
AI_PROVIDER_TIMEOUT_MS=90000
AI_SHORT_MAX_BODY_BYTES=131072
AI_PDF_MAX_BODY_BYTES=1048576
AI_MAX_TRANSLATION_SEGMENTS=2000
AI_MAX_RESPONSE_BYTES=2097152
AI_IDEMPOTENCY_PEPPER=generate_separate_random_value_in_secret_manager
STUDIO_INVITATION_PEPPER=generate_separate_random_value_in_secret_manager
STUDIO_INVITATION_TTL_SECONDS=86400
STUDIO_EVENT_PAGE_SIZE=100
STUDIO_TICKET_PEPPER=generate_separate_random_value_in_secret_manager
STUDIO_TICKET_TTL_SECONDS=30
STUDIO_HEARTBEAT_SECONDS=10
STUDIO_IDLE_TIMEOUT_SECONDS=30
STUDIO_MAX_CONNECTION_SECONDS=3600
STUDIO_MAX_CONNECTIONS=32
STUDIO_MAX_PROFILE_CONNECTIONS=3
STUDIO_MAX_OPERATION_BYTES=65536
STUDIO_MAX_PENDING_EVENTS=500
META_APP_SECRET=never_expose_or_commit
