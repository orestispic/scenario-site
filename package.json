{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vite build --config vite.vercel.config.ts",
    "test:api": "node --experimental-transform-types --test worker/tests/*.test.ts tests/*.test.ts",
    "test:security": "node scripts/security-check.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:api": "wrangler dev --config wrangler.api.toml",
    "start:api:local": "wrangler dev --config wrangler.local-test.toml",
    "activation-key:local:create": "node scripts/create-local-activation-key.mjs",
    "activation-key:local:revoke": "node scripts/revoke-local-activation-key.mjs",
    "phase9:preflight": "node scripts/phase9-preflight.mjs",
    "phase9:accounts:provision": "node scripts/phase9-provision-test-accounts.mjs",
    "phase9:accounts:validate": "node scripts/phase9-validate-test-accounts.mjs",
    "phase9:studio:provision": "node scripts/phase9-provision-studio-fixture.mjs",
    "phase9:studio:secret": "node scripts/phase9-configure-studio-invitation-secret.mjs",
    "phase9:stripe:bind": "node scripts/phase9-bind-stripe-prices.mjs",
    "phase9:realtime:validate": "node scripts/phase9-validate-hosted-realtime.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "supabase": "2.117.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
