{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/offres", "destination": "/index.html" },
    { "source": "/telecharger", "destination": "/index.html" },
    { "source": "/compte", "destination": "/index.html" },
    { "source": "/connexion", "destination": "/index.html" },
    { "source": "/reinitialisation", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/confidentialite", "destination": "/index.html" },
    { "source": "/conditions", "destination": "/index.html" },
    { "source": "/mentions", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
